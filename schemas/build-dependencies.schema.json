{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luftaquila.github.io/fsk-rules/schemas/build-dependencies.schema.json",
  "title": "FSK rules pinned build dependencies",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "toolchain", "assets"],
  "properties": {
    "schema_version": { "const": 1 },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "pandoc", "pypandoc_binary", "latex_action", "texlive_image"],
      "properties": {
        "python": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "pandoc": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
        "pypandoc_binary": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
        "latex_action": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "texlive_image": { "type": "string", "pattern": "^ghcr\\.io/xu-cheng/texlive-full:[0-9]{8}$" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "filename": { "type": "string", "pattern": "^[^/\\\\]+$" },
          "archive_members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pattern"],
              "properties": {
                "pattern": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "oneOf": [
          { "required": ["filename"], "not": { "required": ["archive_members"] } },
          { "required": ["archive_members"], "not": { "required": ["filename"] } }
        ]
      }
    }
  }
}
