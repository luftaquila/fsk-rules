{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luftaquila.github.io/fsk-rules/schemas/rules-index.schema.json",
  "title": "FSK rules index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edition", "document", "rules"],
  "properties": {
    "schema_version": { "const": 2 },
    "edition": { "type": "integer", "minimum": 2000 },
    "document": { "enum": ["formula-technical", "formula-competition"] },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "year", "edition", "document", "citation", "text", "href", "content_hash"],
      "properties": {
        "id": { "type": "string", "pattern": "^formula-(technical|competition)-[a-z0-9-]+$" },
        "year": { "type": "integer", "minimum": 2000 },
        "edition": { "type": "integer", "minimum": 2000 },
        "document": { "enum": ["formula-technical", "formula-competition"] },
        "rule_key": { "type": "string", "pattern": "^formula-(technical|competition)\\.[a-z0-9]+([.-][a-z0-9]+)*$" },
        "citation": { "type": "string", "minLength": 3 },
        "text": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "pattern": "^#formula-(technical|competition)-" },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "document": { "const": "formula-technical" } } },
          "then": {
            "properties": {
              "id": { "pattern": "^formula-technical-" },
              "rule_key": { "pattern": "^formula-technical\\." },
              "href": { "pattern": "^#formula-technical-" }
            }
          }
        },
        {
          "if": { "properties": { "document": { "const": "formula-competition" } } },
          "then": {
            "properties": {
              "id": { "pattern": "^formula-competition-" },
              "rule_key": { "pattern": "^formula-competition\\." },
              "href": { "pattern": "^#formula-competition-" }
            }
          }
        }
      ]
    }
  }
}
