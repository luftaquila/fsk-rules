{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luftaquila.github.io/fsk-rules/schemas/rules-manifest.schema.json",
  "title": "FSK rules manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "latest_edition", "deployment", "documents"],
  "properties": {
    "schema_version": { "const": 2 },
    "latest_edition": { "type": "integer", "minimum": 2000 },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_tag", "source_commit"],
      "properties": {
        "site_tag": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^site-[0-9]{8}\\.[1-9][0-9]*$" }
          ]
        },
        "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edition", "revision", "version", "release_tag", "document_digest", "document", "title", "short_title", "effective_date", "web_path", "pdf_path", "index_path", "source"],
        "properties": {
          "edition": { "type": "integer", "minimum": 2000 },
          "revision": { "type": "integer", "minimum": 1 },
          "version": { "type": "string", "pattern": "^[0-9]{4}-r[1-9][0-9]*$" },
          "release_tag": { "type": "string", "pattern": "^formula-(technical|competition)-[0-9]{4}-r[1-9][0-9]*$" },
          "document_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "document": { "enum": ["formula-technical", "formula-competition"] },
          "title": { "type": "string" },
          "short_title": { "type": "string" },
          "effective_date": { "type": "string", "format": "date" },
          "web_path": { "type": "string" },
          "pdf_path": { "type": "string" },
          "index_path": { "type": "string" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "post_id", "published_date", "post_url", "pdf_hash"],
            "properties": {
              "status": { "const": "verified" },
              "post_id": { "type": "integer" },
              "published_date": { "type": "string", "format": "date" },
              "post_url": { "type": "string", "pattern": "^https://www\\.ksae\\.org/jajak/bbs/" },
              "pdf_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}
